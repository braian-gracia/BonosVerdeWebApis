          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json().data;",
                  "pm.environment.set('token', data.token);",
                  "pm.environment.set('refreshToken', data.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nuevo@bonosverde.com\",\n  \"name\": \"Usuario Postman\",\n  \"password\": \"postman123\",\n  \"referralCode\": \"CURV-ADM1-0001\"\n}",
